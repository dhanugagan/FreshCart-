# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase (Auth + PostgreSQL + Storage for Product Images & User Documents)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth 2.0 Credentials (optional direct Google OAuth alongside Supabase Google Auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Maps Platform API key
VITE_GOOGLE_MAPS_API_KEY=

# Payment Gateway credentials (runs local checkout flow if omitted)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Admin Passcode for /admin unlock (configure in Settings -> Secrets or Vercel Env Vars)
ADMIN_PASSCODE=

# Backend & Database configuration
VITE_API_BASE_URL=/api
SESSION_SECRET=
DB_PATH=./freshcart.db
